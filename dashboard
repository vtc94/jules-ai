    .score-ring { transition: stroke-dashoffset 0.8s cubic-bezier(0.4, 0, 0.2, 1); }
    .card-glass { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1rem; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3); transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
    .card-glass:hover { transform: translateY(-2px); box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.4); border-color: rgba(56, 189, 248, 0.4); }
    .progress-fill { transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
    .fade-in { animation: fadeIn 0.5s ease forwards; opacity: 0; }
    .fade-in-delay-1 { animation-delay: 0.1s; }
    .fade-in-delay-2 { animation-delay: 0.2s; }
    .fade-in-delay-3 { animation-delay: 0.3s; }
    .fade-in-delay-4 { animation-delay: 0.4s; }
    @keyframes fadeIn { to { opacity: 1; transform: translateY(0); } from { opacity: 0; transform: translateY(12px); } }
    @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    .pulse-dot { animation: pulse-dot 2s ease-in-out infinite; }
    canvas { max-width: 100%; }
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    input[type="number"] { -moz-appearance: textfield; }

    /* Mega menu positioning */
    .nav-item { position: relative; }
    .mega-menu { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); opacity: 0; visibility: hidden; transition: opacity 0.2s, visibility 0.2s; z-index: 50; padding-top: 8px; }
    .nav-item:hover>.mega-menu { opacity: 1; visibility: visible; }

    /* Sub-menus for Practice flyouts */
    .sub-item { position: relative; }
    .sub-menu { position: absolute; left: 100%; top: 0; opacity: 0; visibility: hidden; transition: opacity 0.15s, visibility 0.15s; z-index: 60; padding-left: 4px; }
    .sub-item:hover>.sub-menu { opacity: 1; visibility: visible; }

    /* Tertiary menus (Free/Paid test types) */
    .tertiary-item { position: relative; }
    .tertiary-menu { position: absolute; left: 100%; top: 0; opacity: 0; visibility: hidden; transition: opacity 0.15s, visibility 0.15s; z-index: 70; padding-left: 4px; }
    .tertiary-item:hover>.tertiary-menu { opacity: 1; visibility: visible; }

    /* Mobile menu */
