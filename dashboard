    .mobile-menu.open { max-height: 2000px; }
    .mobile-accordion { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
    .mobile-accordion.open { max-height: 800px; }

    /* Smooth hover for menu items */
    .menu-link { transition: color 0.15s, background 0.15s; }
