    // ---- Greeting ----
    function updateGreeting(name) {
      const h = new Date().getHours();
      const prefix = h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
      document.getElementById('greeting').textContent = `${prefix}, ${name} 👋`;
    }

    // ---- Scores display ----
    function displayScores() {
      const ring = document.getElementById('overall-ring');
      const circumference = 364.42;
      const offset = circumference - (userScores.overall / 90) * circumference;
      ring.style.strokeDashoffset = offset;
      document.getElementById('overall-score-val').textContent = userScores.overall;
      document.getElementById('score-listening').textContent = userScores.listening;
      document.getElementById('score-reading').textContent = userScores.reading;
      document.getElementById('score-speaking').textContent = userScores.speaking;
      document.getElementById('score-writing').textContent = userScores.writing;
    }

    // ---- Chart drawing (pure canvas) ----
    function drawChart() {
      const canvas = document.getElementById('perfChart');
      const ctx = canvas.getContext('2d');
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      canvas.style.width = rect.width + 'px';
      canvas.style.height = rect.height + 'px';
      ctx.scale(dpr, dpr);

      const w = rect.width;
      const h = rect.height;
      const pad = { top: 10, right: 15, bottom: 35, left: 35 };
      const cw = w - pad.left - pad.right;
      const ch = h - pad.top - pad.bottom;

      ctx.clearRect(0, 0, w, h);

      const data = perfData[currentPeriod][currentSkill];
      if (!data || data.length === 0) return;

      // Grid lines
      ctx.strokeStyle = 'rgba(148,163,184,0.08)';
      ctx.lineWidth = 1;
      for (let i = 0; i <= 9; i++) {
        const y = pad.top + (ch / 9) * i;
        ctx.beginPath();
        ctx.moveTo(pad.left, y);
        ctx.lineTo(pad.left + cw, y);
        ctx.stroke();
      }

      // Y labels
      ctx.fillStyle = 'rgba(148,163,184,0.5)';
      ctx.font = '10px "Space Mono", monospace';
      ctx.textAlign = 'right';
      for (let i = 0; i <= 9; i++) {
        const val = 90 - i * 10;
        const y = pad.top + (ch / 9) * i;
        ctx.fillText(val, pad.left - 6, y + 3);
      }

      // X labels
      ctx.textAlign = 'center';
      const step = Math.max(1, Math.floor(data.length / 6));
      data.forEach((d, i) => {
        if (i % step === 0 || i === data.length - 1) {
          const x = pad.left + (cw / (data.length - 1)) * i;
          const label = d.date.toLocaleDateString('en', { month: 'short', day: 'numeric' });
          ctx.fillText(label, x, h - 8);
        }
      });

      // Line + area
      const points = data.map((d, i) => ({
        x: pad.left + (cw / (data.length - 1)) * i,
        y: pad.top + ch - (d.score / 90) * ch
      }));

      // Area fill
      const grad = ctx.createLinearGradient(0, pad.top, 0, pad.top + ch);
      grad.addColorStop(0, 'rgba(14,165,233,0.25)');
      grad.addColorStop(1, 'rgba(14,165,233,0)');
      ctx.beginPath();
      ctx.moveTo(points[0].x, pad.top + ch);
      points.forEach(p => ctx.lineTo(p.x, p.y));
      ctx.lineTo(points[points.length - 1].x, pad.top + ch);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();

      // Line
      ctx.beginPath();
      points.forEach((p, i) => i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y));
      ctx.strokeStyle = '#0866ff';
      ctx.lineWidth = 2.5;
      ctx.lineJoin = 'round';
      ctx.stroke();

      // Dots
      points.forEach(p => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 3.5, 0, Math.PI * 2);
        ctx.fillStyle = '#0866ff';
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      });
    }

    // ---- Focus Areas ----
    function renderFocusAreas(targets) {
      const container = document.getElementById('focus-areas-content');
      const carousel = document.getElementById('carousel-controls');

      if (!targets) {
        container.innerHTML = '<div class="text-center py-8 text-slate-500"><p class="text-sm">Set your target scores and click <strong class="text-[#0866ff]">Get Advice</strong> to see your focus areas.</p></div>';
        carousel.classList.add('hidden');
        lucide.createIcons();
        return;
      }

      if (targets !== lastTargets) {
        lastTargets = targets;
        focusPage = 0;
      }

      // Collect all sub-skills with gaps
      const allSkills = [];
      const skillTargets = {
        speaking: targets.speaking_target,
        writing: targets.writing_target,
        reading: targets.reading_target,
        listening: targets.listening_target
      };

      Object.entries(subSkills).forEach(([category, skills]) => {
        const target = skillTargets[category] || 65;
        skills.forEach(s => {
          const gap = target - s.score;
          if (gap > 0) {
            let priority = 'low';
            if (gap > 20) priority = 'critical';
            else if (gap > 10) priority = 'moderate';
            allSkills.push({ ...s, category, target, gap, priority });
          }
        });
      });

      allSkills.sort((a, b) => b.gap - a.gap);

      if (allSkills.length === 0) {
        container.innerHTML = '<div class="text-center py-8"><div class="w-12 h-12 rounded-full bg-emerald-500/15 flex items-center justify-center mx-auto mb-3"><i data-lucide="check-circle" style="width:24px;height:24px;" class="text-emerald-400"></i></div><p class="text-emerald-300 font-medium">All skills meet your targets!</p><p class="text-slate-500 text-sm mt-1">Keep up the great work.</p></div>';
        carousel.classList.add('hidden');
        lucide.createIcons();
        return;
      }

      // Filter by priority
      filteredFocusSkills = focusFilter === 'all' ? allSkills : allSkills.filter(s => s.priority === focusFilter);

      if (filteredFocusSkills.length === 0) {
        container.innerHTML = `<div class="text-center py-8 text-slate-500"><p class="text-sm">No skills found for priority: <strong class="text-[#0866ff] capitalize">${focusFilter}</strong></p></div>`;
        carousel.classList.add('hidden');
        lucide.createIcons();
        return;
      }

      const totalPages = Math.ceil(filteredFocusSkills.length / 5);
      if (focusPage >= totalPages) focusPage = totalPages - 1;
      if (focusPage < 0) focusPage = 0;

      const itemsToShow = filteredFocusSkills.slice(focusPage * 5, (focusPage + 1) * 5);

      const colorMap = {
        critical: { bg: 'rgba(244,63,94,0.1)', border: 'rgba(244,63,94,0.2)', bar: '#f43f5e', text: '#fda4af', badge: 'rgba(244,63,94,0.2)', label: 'Critical' },
        moderate: { bg: 'rgba(245,158,11,0.1)', border: 'rgba(245,158,11,0.2)', bar: '#f59e0b', text: '#fcd34d', badge: 'rgba(245,158,11,0.2)', label: 'Moderate' },
        low: { bg: 'rgba(56,189,248,0.1)', border: 'rgba(56,189,248,0.2)', bar: '#38bdf8', text: '#7dd3fc', badge: 'rgba(56,189,248,0.2)', label: 'Low' }
      };

      const categoryLabels = { speaking: 'Speaking', writing: 'Writing', reading: 'Reading', listening: 'Listening' };

      let html = '<div class="space-y-3">';
      itemsToShow.forEach(s => {
        const c = colorMap[s.priority];
        const pct = Math.round((s.score / 90) * 100);
        html += `<div class="p-4 rounded-xl border transition-colors hover:bg-white/5" style="background:${c.bg};border-color:${c.border}">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-3">
              <span class="text-sm font-semibold text-white">${s.name}</span>
              <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider" style="background:${c.badge};color:${c.text}">${c.label}</span>
            </div>
            <span class="text-xs text-slate-400 font-medium">${categoryLabels[s.category]}</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="flex-grow h-1.5 rounded-full bg-slate-900/60 overflow-hidden">
              <div class="progress-fill h-full rounded-full" style="width:${pct}%;background:${c.bar}"></div>
            </div>
            <span class="text-xs font-mono font-bold text-slate-200 shrink-0">${s.score}<span class="text-slate-500">/90</span></span>
          </div>
        </div>`;
      });
      html += '</div>';

      container.innerHTML = html;

      // Update Carousel UI
      carousel.classList.toggle('hidden', totalPages <= 1);
      document.getElementById('carousel-counter').textContent = `${focusPage + 1} / ${totalPages}`;
      document.getElementById('prev-slide').disabled = focusPage === 0;
      document.getElementById('next-slide').disabled = focusPage === totalPages - 1;

      const dotsContainer = document.getElementById('carousel-dots');
      dotsContainer.innerHTML = '';
      for (let i = 0; i < totalPages; i++) {
        const dot = document.createElement('button');
        dot.className = `w-6 h-6 rounded flex items-center justify-center text-[10px] font-bold transition-all ${i === focusPage ? 'bg-gradient-to-r from-sky-500 to-indigo-500 text-white' : 'bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10'}`;
        dot.textContent = i + 1;
        dot.onclick = () => { focusPage = i; renderFocusAreas(targets); };
        dotsContainer.appendChild(dot);
      }

      // Animate progress bars
      requestAnimationFrame(() => {
        container.querySelectorAll('.progress-fill').forEach(el => {
          const w = el.style.width;
          el.style.width = '0%';
          setTimeout(() => { el.style.width = w; }, 50);
        });
      });
      lucide.createIcons();
    }

    // ---- Exam date (Auto Estimated) ----
    function updateEstimatedExamDate(targets) {
      const display = document.getElementById('exam-date-display');
      const badge = document.getElementById('days-left-badge');
      const number = document.getElementById('days-left-number');

      if (!targets) {
        display.textContent = 'Not set';
        badge.classList.add('hidden');
        return;
      }

      const skillTargets = {
        speaking: targets.speaking_target || 79,
        writing: targets.writing_target || 79,
        reading: targets.reading_target || 79,
        listening: targets.listening_target || 79
      };

      let totalGap = 0;
      totalGap += Math.max(0, skillTargets.speaking - userScores.speaking);
      totalGap += Math.max(0, skillTargets.writing - userScores.writing);
      totalGap += Math.max(0, skillTargets.reading - userScores.reading);
      totalGap += Math.max(0, skillTargets.listening - userScores.listening);

      // Estimate logic: 1.5 days per point gap, minimum 7 days if any gap exists
      const daysNeeded = totalGap > 0 ? Math.max(7, Math.ceil(totalGap * 1.5)) : 0;

      const examDate = new Date();
      examDate.setDate(examDate.getDate() + daysNeeded);
      examDate.setHours(0, 0, 0, 0);

      display.textContent = totalGap > 0 ? examDate.toLocaleDateString('en', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : 'Ready for Exam!';

      if (totalGap > 0) {
        number.textContent = daysNeeded;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    // ---- Focus Filter Events ----
    document.querySelectorAll('.focus-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.focus-filter-btn').forEach(b => {
          b.classList.remove('active', 'bg-gradient-to-r', 'from-sky-500', 'to-indigo-500', 'text-white');
          b.classList.add('bg-white/5', 'border-white/10');
          if (b.dataset.priority === 'critical') b.classList.add('text-rose-400');
          if (b.dataset.priority === 'moderate') b.classList.add('text-amber-400');
          if (b.dataset.priority === 'low') b.classList.add('text-sky-400');
        });
        btn.classList.add('active', 'bg-gradient-to-r', 'from-sky-500', 'to-indigo-500', 'text-white');
        btn.classList.remove('bg-white/5', 'border-white/10', 'text-rose-400', 'text-amber-400', 'text-sky-400');
        focusFilter = btn.dataset.priority;
        focusPage = 0;
        renderFocusAreas(lastTargets);
      });
    });

    // ---- Carousel Events ----
    document.getElementById('prev-slide').addEventListener('click', () => {
      if (focusPage > 0) {
        focusPage--;
        renderFocusAreas(lastTargets);
      }
    });

    document.getElementById('next-slide').addEventListener('click', () => {
      const totalPages = Math.ceil(filteredFocusSkills.length / 5);
      if (focusPage < totalPages - 1) {
        focusPage++;
        renderFocusAreas(lastTargets);
      }
    });

    // ---- Performance button events ----
    document.querySelectorAll('.perf-skill-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.perf-skill-btn').forEach(b => { b.className = 'perf-skill-btn px-2.5 py-1 rounded-md text-xs font-medium bg-white/5 text-slate-400 hover:text-white hover:bg-white/10 transition border border-white/10'; });
        btn.className = 'perf-skill-btn active px-2.5 py-1 rounded-md text-xs font-medium bg-gradient-to-r from-sky-500 to-indigo-500 text-white transition shadow-lg shadow-sky-500/20';
        currentSkill = btn.dataset.skill;
        drawChart();
      });
    });

    document.querySelectorAll('.perf-period-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.perf-period-btn').forEach(b => { b.className = 'perf-period-btn px-2.5 py-1 rounded-md text-xs font-medium bg-white/5 text-slate-500 border border-transparent hover:bg-white/10 transition'; });
        btn.className = 'perf-period-btn active px-2.5 py-1 rounded-md text-xs font-medium bg-sky-500/20 text-sky-300 border border-sky-500/30 transition';
        currentPeriod = btn.dataset.period;
        drawChart();
      });
    });

    // ---- Target form ----
    ['target-overall', 'target-speaking', 'target-writing', 'target-reading', 'target-listening'].forEach(id => {
      document.getElementById(id).addEventListener('input', () => {
        const tg = {
          overall_target: parseInt(document.getElementById('target-overall').value) || 0,
          speaking_target: parseInt(document.getElementById('target-speaking').value) || 0,
          writing_target: parseInt(document.getElementById('target-writing').value) || 0,
          reading_target: parseInt(document.getElementById('target-reading').value) || 0,
          listening_target: parseInt(document.getElementById('target-listening').value) || 0
        };
        updateEstimatedExamDate(tg);
      });
    });

    document.getElementById('target-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const overall = parseInt(document.getElementById('target-overall').value) || 0;
      const speaking = parseInt(document.getElementById('target-speaking').value) || 0;
      const writing = parseInt(document.getElementById('target-writing').value) || 0;
      const reading = parseInt(document.getElementById('target-reading').value) || 0;
      const listening = parseInt(document.getElementById('target-listening').value) || 0;

      if (!overall && !speaking && !writing && !reading && !listening) {
        const toast = document.getElementById('target-toast');
        toast.textContent = 'Please enter at least one target score.';
        toast.className = 'mt-3 p-3 rounded-lg bg-rose-500/15 border border-rose-400/20 text-rose-300 text-sm text-center';
        setTimeout(() => toast.classList.add('hidden'), 3000);
        return;
      }

      const btn = document.getElementById('advice-btn');
      btn.disabled = true;
      btn.innerHTML = '<span class="pulse-dot">Analyzing...</span>';

      const existing = allRecords.find(r => r.type === 'targets');
      let result;
      if (existing) {
        result = await window.dataSdk.update({ ...existing, overall_target: overall, speaking_target: speaking, writing_target: writing, reading_target: reading, listening_target: listening });
      } else {
        if (allRecords.length >= 999) { btn.disabled = false; btn.innerHTML = '<i data-lucide="sparkles" style="width:16px;height:16px;"></i> Get Advice'; lucide.createIcons(); return; }
        result = await window.dataSdk.create({ type: 'targets', overall_target: overall, speaking_target: speaking, writing_target: writing, reading_target: reading, listening_target: listening, exam_date: '' });
      }

      btn.disabled = false;
      btn.innerHTML = '<i data-lucide="sparkles" style="width:16px;height:16px;"></i> Get Advice';
      lucide.createIcons();

      if (result.isOk) {
        const toast = document.getElementById('target-toast');
        toast.textContent = '✓ Focus areas updated!';
        toast.className = 'mt-3 p-3 rounded-lg bg-emerald-500/15 border border-emerald-400/20 text-emerald-300 text-sm text-center';
        setTimeout(() => toast.classList.add('hidden'), 3000);
      }
    });

    // ---- Data SDK ----
    const dataHandler = {
      onDataChanged(data) {
        allRecords = data;
        const targetRec = data.find(r => r.type === 'targets');
        if (targetRec) {
          if (targetRec.overall_target) document.getElementById('target-overall').value = targetRec.overall_target;
          if (targetRec.speaking_target) document.getElementById('target-speaking').value = targetRec.speaking_target;
          if (targetRec.writing_target) document.getElementById('target-writing').value = targetRec.writing_target;
          if (targetRec.reading_target) document.getElementById('target-reading').value = targetRec.reading_target;
          if (targetRec.listening_target) document.getElementById('target-listening').value = targetRec.listening_target;
          const tg = { overall_target: targetRec.overall_target, speaking_target: targetRec.speaking_target, writing_target: targetRec.writing_target, reading_target: targetRec.reading_target, listening_target: targetRec.listening_target };
          renderFocusAreas(tg);
          updateEstimatedExamDate(tg);
        }
      }
    };

    // ---- Element SDK ----
    const defaultConfig = {
      greeting_name: 'Student',
      page_title: 'PTE Learning Tracker',
      background_color: '#0f172a',
      surface_color: '#1e293b',
      text_color: '#ffffff',
      primary_action_color: '#0ea5e9',
      secondary_action_color: '#6366f1',
      font_family: 'Inter',
      font_size: 16
    };

    try {
      window.elementSdk.init({
        defaultConfig,
        onConfigChange: async (config) => {
        const name = config.greeting_name || defaultConfig.greeting_name;
        const title = config.page_title || defaultConfig.page_title;
        const bg = config.background_color || defaultConfig.background_color;
        const surface = config.surface_color || defaultConfig.surface_color;
        const text = config.text_color || defaultConfig.text_color;
        const primary = config.primary_action_color || defaultConfig.primary_action_color;
        const secondary = config.secondary_action_color || defaultConfig.secondary_action_color;
        const font = config.font_family || defaultConfig.font_family;
        const fontSize = config.font_size || defaultConfig.font_size;

        updateGreeting(name);
        document.getElementById('nav-title').textContent = title;

        // Colors
        const shell = document.querySelector('.app-shell');
        if (config.background_color) {
          shell.style.background = bg;
        }

        document.querySelectorAll('.card-glass').forEach(el => {
          if (config.surface_color) {
            el.style.backgroundColor = surface;
          }
        });

        document.querySelectorAll('.perf-skill-btn.active').forEach(el => { el.style.backgroundColor = primary; });
        document.querySelectorAll('#advice-btn, #set-date-btn').forEach(el => { el.style.backgroundColor = primary; });

        document.querySelectorAll('h1, h2, p, span, label').forEach(el => {
          if (!el.closest('.card-glass') || el.tagName === 'H1') {
            el.style.color = text;
          }
        });

        // Font
        const fontStack = `${font}, system-ui, sans-serif`;
        document.querySelector('.app-shell').style.fontFamily = fontStack;

        // Font size
        const base = fontSize;
        document.getElementById('greeting').style.fontFamily = fontStack;
        document.getElementById('greeting').style.fontSize = `${base * 2.5}px`;
        document.querySelectorAll('.card-glass h2').forEach(el => { el.style.fontSize = `${base * 0.8}px`; });
      },
      mapToCapabilities: (config) => ({
        recolorables: [
          { get: () => config.background_color || defaultConfig.background_color, set: (v) => { config.background_color = v; window.elementSdk.setConfig({ background_color: v }); } },
          { get: () => config.surface_color || defaultConfig.surface_color, set: (v) => { config.surface_color = v; window.elementSdk.setConfig({ surface_color: v }); } },
          { get: () => config.text_color || defaultConfig.text_color, set: (v) => { config.text_color = v; window.elementSdk.setConfig({ text_color: v }); } },
          { get: () => config.primary_action_color || defaultConfig.primary_action_color, set: (v) => { config.primary_action_color = v; window.elementSdk.setConfig({ primary_action_color: v }); } },
          { get: () => config.secondary_action_color || defaultConfig.secondary_action_color, set: (v) => { config.secondary_action_color = v; window.elementSdk.setConfig({ secondary_action_color: v }); } }
        ],
        borderables: [],
        fontEditable: { get: () => config.font_family || defaultConfig.font_family, set: (v) => { config.font_family = v; window.elementSdk.setConfig({ font_family: v }); } },
        fontSizeable: { get: () => config.font_size || defaultConfig.font_size, set: (v) => { config.font_size = v; window.elementSdk.setConfig({ font_size: v }); } }
      }),
      mapToEditPanelValues: (config) => new Map([
        ['greeting_name', config.greeting_name || defaultConfig.greeting_name],
        ['page_title', config.page_title || defaultConfig.page_title]
        ])
      });
    } catch (e) {
      console.warn('Element SDK initialization failed:', e);
    }

    // ---- Init ----
    async function init() {
      // Fallback data if SDK doesn't load a record
      const defaultTargets = { overall_target: 79, speaking_target: 79, writing_target: 79, reading_target: 79, listening_target: 79 };

      try {
        updateGreeting(defaultConfig.greeting_name);
        displayScores();
        drawChart();

        // Initial render with fallback data
        renderFocusAreas(defaultTargets);
        updateEstimatedExamDate(defaultTargets);

        lucide.createIcons();
      } catch (e) {
        console.error('Initial render failed', e);
      }

      try {
        if (window.dataSdk) {
          const initResult = await window.dataSdk.init(dataHandler);
          if (initResult.isOk) {
            // Data SDK will trigger onDataChanged if a record exists
          } else {
            console.error('Data SDK init failed');
          }
        }
      } catch (e) {
        console.warn('Data SDK failure, using dummy data', e);
      }
    }

    init();

    // Resize chart
    window.addEventListener('resize', drawChart);
  </script>
